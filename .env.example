# Copie para .env.local. Os valores NEXT_PUBLIC identificam o projeto; não são credenciais administrativas.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Apenas no servidor. Nunca usar prefixo NEXT_PUBLIC nestas três variáveis.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
